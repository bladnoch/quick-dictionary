{
  "manifest_version": 3,
  "name": "선택 사전 · NAVER & Google",
  "version": "1.1.3",
  "description": "드래그한 단어는 네이버 영어사전, 문장은 Google 번역으로. 자동 표시와 번역 버튼 모드를 지원합니다.",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "contextMenus", "activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://en.dict.naver.com/*",
    "https://ac-dict.naver.com/*",
    "https://translate.google.com/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "선택 사전 설정",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["shared.js", "selection-utils.js", "messaging.js", "bubble-styles.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],
  "commands": {
    "lookup-selection": {
      "suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"},
      "description": "선택한 단어 또는 문장 조회"
    }
  },
  "options_ui": {"page": "popup.html", "open_in_tab": true}
}
